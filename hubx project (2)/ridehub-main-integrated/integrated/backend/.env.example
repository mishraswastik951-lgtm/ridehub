# =============================================================================
# RideHub Backend — Environment Template
# =============================================================================
# Copy this file to .env and fill in real values for your environment.
# NEVER commit the real .env file to git. The .gitignore already excludes it.
# =============================================================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB (single-node local instance for development)
MONGODB_URI=mongodb://localhost:27017/ridehub

# Connection retry behavior
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# UPI merchant (public VPA — shown to customers, not a secret)
UPI_MERCHANT_VPA=ridehub@icici
UPI_MERCHANT_NAME=RideHub Rentals

# OTP settings
OTP_TTL_SECONDS=300
# Secret used to hash OTPs at rest in the otp collection. Generate a strong
# random string for production (e.g. `openssl rand -hex 32`).
OTP_HASH_SECRET=replace-with-strong-random-secret

# In demo mode (NODE_ENV !== 'production'), the OTP is also returned in the
# /api/auth/send-otp response so the frontend can auto-fill. Set NODE_ENV=production
# to suppress this behavior.
